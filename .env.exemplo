# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
# Passo a passo para conseguir cada chave: docs/CONFIGURAR.md

# Segurança: com true nada é publicado nem gasto (só gera os arquivos para você conferir).
MODO_SIMULACAO=true

# --- Claude (planejamento, legendas e o agente) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-opus-5-5
# CLAUDE_ESFORCO=medium

# --- Geração de imagens com IA (opcional) ---
# Sem esta chave, as artes usam as fotos reais dos produtos sobre as cores da marca.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Instagram / Meta ---
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_PAGE_ID=
# Só para tráfego pago:
META_AD_ACCOUNT_ID=
# META_GRAPH_VERSION=v23.0

# --- Hospedagem das mídias (o Instagram baixa as imagens/vídeos de um link público) ---
MIDIA_HOST=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternativa: uma pasta servida pelo seu site
# MIDIA_HOST=pasta_publica
# PASTA_PUBLICA=/var/www/minhaloja/midia
# URL_PUBLICA_BASE=https://minhaloja.com.br/midia
